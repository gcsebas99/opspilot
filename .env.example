# Copy to .env and fill in. Never commit the real .env (it's gitignored).

ANTHROPIC_API_KEY=

# Model IDs are never hardcoded in code -- see https://docs.claude.com/en/docs/about-claude/models
OPSPILOT_MODEL=claude-sonnet-5
OPSPILOT_JUDGE_MODEL=claude-sonnet-5

# Loop exit conditions (docs/specs/day1.md -- [HARNESS:LOOP])
OPSPILOT_MAX_STEPS=15
OPSPILOT_TOKEN_BUDGET=60000

# Context / tool output truncation (docs/specs/day1.md -- [HARNESS:CONTEXT])
OPSPILOT_TOOL_OUTPUT_MAX_CHARS=4000
